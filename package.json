{
  "name": "excel-bi-builder",
  "version": "0.2.6",
  "description": "积木式 Excel 可视化处理工具 - 类 Tableau 的拖拽编码 BI",
  "main": "dist-electron/electron/main.js",
  "author": "Excel BI Builder",
  "license": "MIT",
  "scripts": {
    "dev": "vite --open",
    "dev:web": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "build:web": "vite build",
    "build:electron": "vite build && tsc -p electron/tsconfig.json",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "start:electron": "electron .",
    "pack": "npm run build:electron && electron-builder --dir",
    "pack:win": "npm run build:electron && electron-builder --win",
    "pack:mac": "npm run build:electron && electron-builder --mac",
    "pack:linux": "npm run build:electron && electron-builder --linux"
  },
  "dependencies": {
    "@antv/g2": "^5.2.10",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@types/leaflet": "^1.9.22",
    "@xyflow/react": "^12.11.2",
    "duckdb": "^1.1.0",
    "echarts": "^6.1.0",
    "leaflet": "^1.9.4",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.excelbi.builder",
    "productName": "Excel BI Builder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
